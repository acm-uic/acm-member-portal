{
  "name": "acm-member-portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --mode ssr",
    "build": "bun run build.client && bun run build.server",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/fastify/vite.config.ts",
    "serve": "node server/entry.fastify.js",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.ts",
    "auth:generate": "bunx auth@latest generate",
    "fmt": "prettier --write ."
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@electric-sql/pglite": "^0.5.7",
    "better-auth": "1.7.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "~7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
