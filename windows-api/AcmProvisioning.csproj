<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AcmProvisioning</RootNamespace>
    <AssemblyName>AcmProvisioning</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- LDAP/ADSI. Hosted PowerShell cannot load RSAT ActiveDirectory (SMA
         looks for built-in modules under the publish folder, not $PSHOME). -->
    <PackageReference Include="System.DirectoryServices" Version="10.0.11" />
    <!-- SCM lifetime so sc.exe start can handshake (error 1053 without this) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>

</Project>
