<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AcmProvisioning</RootNamespace>
    <AssemblyName>AcmProvisioning</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- PowerShell engine for the New-ADUser runspace. Microsoft.PowerShell.SDK
         pulls Diagnostics/WSMan snap-ins that a web host does not need and can
         prevent the process from reporting to SCM (error 1053). CreateDefault2()
         does not load those snap-ins, so SMA alone is enough. -->
    <PackageReference Include="System.Management.Automation" Version="7.6.5" />
    <!-- SCM lifetime so sc.exe start can handshake (error 1053 without this) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>

</Project>
