<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AcmProvisioning</RootNamespace>
    <AssemblyName>AcmProvisioning</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Engine + command assemblies. System.Management.Automation alone
         omits Microsoft.PowerShell.Commands.Diagnostics.dll and friends. -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.5" />
    <!-- SCM lifetime so sc.exe start can handshake (error 1053 without this) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>

</Project>
