# --- Optional for local embedded mode ---
# Omit DATABASE_URL (and leave SMTP / Windows / Entra empty) to use in-process
# PGlite at .data/pglite with mail + AD stubs. Then: bun run dev
# PGLITE_DATA_DIR=.data/pglite
# DEV_LOGIN=1                 # force email/password login even with DATABASE_URL
# MAIL_DIR=.data/mail

# Postgres (CloudNativePG in prod; required in production)
DATABASE_URL=postgres://portal:portal@localhost:5432/portal

# Better Auth (defaults applied automatically in embedded local mode)
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:5173
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Discord linking (optional). Leave empty to hide Discord UI.
# Redirect URIs: {ORIGIN}/api/auth/callback/discord and {ORIGIN}/signup/discord/callback
# Bot token is not required for linking.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Qwik City CSRF origin check (public origin in prod)
ORIGIN=http://localhost:5173

# Self-hosted SMTP (credential + notification mail)
# Leave SMTP_HOST empty locally to write mail under .data/mail/
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ACM@UIC <portal@acm-uic.org>

# Windows provisioning API
# Leave WINDOWS_API_URL empty locally to stub AD user creation
WINDOWS_API_URL=https://ad-api.acm.local
WINDOWS_API_TOKEN=

# Server
PORT=3000
